# Mainspring 机枢 · 环境变量样例
#
# 用法：cp .env.example .env 然后填真值。
# .env 已被 .gitignore 挡住，不会进仓库；**真凭据永远只存在 .env 里**。

# ────────────── 必填 ──────────────

# 人类通道（浏览器）的登录账号。MS_PASS 留空 ⇒ 整个人类通道禁用。
MS_USER=admin
MS_PASS=change-me

# 本实例对外的主机名/IP。**只写主机，不要带 http:// 和端口。**
# ⚠️ 它同时决定 MCP 的 DNS-rebinding 白名单（allowed_hosts）——
#    填错的话外部 AI 连 /mcp 会拿到 `421 Invalid Host header`。
#    只在本机试，就保持 127.0.0.1。
MS_PUBLIC_HOST=127.0.0.1

# ────────────── 选填 ──────────────

# 监听地址与端口。
# 只在本机试就保持 127.0.0.1；要让别的机器 / 手机接入，改成 0.0.0.0。
MS_HOST=127.0.0.1
MS_PORT=8787

# Cookie 签名密钥。留空则由 MS_PASS 派生；生产环境建议显式给一个随机串：
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MS_SECRET=

# 对外基址（可带路径前缀）。设了它，**内置接入指南与服务启动日志**都用它；
# 不设则由 MS_PUBLIC_HOST + MS_PORT 拼。两者不一致时以它为准。
MS_PUBLIC_URL=

# 数据库路径（默认 <仓库根>/ms.sqlite3）。自测/多实例时用它隔离。
MS_DB=

# 项目镜像文件夹（默认 <仓库根>/projects）
MS_PROJECTS=

# 只在「从 v1 升级」时用：首次启动把 v1 的旧 token 落库为一条 admin token，保证老 agent 不断线。
# 日常部署留空。
MS_TOKEN=

# ────────────── 只有工具会用 ──────────────

# tools/migrate_v1_to_v2.py 读的 v1 数据文件（默认 <仓库根>/wb.json）
MS_JSON=

# tools/probe.py 的目标地址（默认 http://127.0.0.1:8787）
MS_PROBE_URL=
